<Window x:Class="Library.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Об авторах" 
        Height="520" Width="720"
        Icon="/Library;component/images/icons8-сортировка-32.png"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="#F0F4F8">

    <Grid>
        <!-- Верхняя полоса с заголовком -->
        <Grid.RowDefinitions>
            <RowDefinition Height="50"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="60"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#2196F3">
            <TextBlock Text="Об авторах" 
                       Foreground="White"
                       FontSize="18"
                       FontWeight="Bold"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Center"/>
        </Border>

        <!-- Карточки авторов -->
        <Grid Grid.Row="1" Margin="25,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ЛЕВАЯ КАРТОЧКА: Станислав -->
            <Border Grid.Column="0" 
                    Background="White"
                    CornerRadius="20"
                    Margin="8"
                    Padding="20">
                <Border.Effect>
                    <DropShadowEffect ShadowDepth="1" BlurRadius="15" Opacity="0.15" Color="#000000"/>
                </Border.Effect>

                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">

                    <!-- Фото -->
                    <Border Width="130" Height="130" 
                            CornerRadius="65"
                            BorderBrush="#2196F3"
                            BorderThickness="3">
                        <Border.Background>
                            <ImageBrush ImageSource="/Library;component/images/photo_2025-11-29_22-58-09.png"
                                        Stretch="UniformToFill"/>
                        </Border.Background>
                    </Border>

                    <!-- Имя -->
                    <TextBlock Text="Кондратьев Станислав" 
                               FontSize="17" 
                               FontWeight="SemiBold"
                               Foreground="#1A237E"
                               HorizontalAlignment="Center"
                               Margin="0,18,0,2"/>

                    <TextBlock Text="Денисович" 
                               FontSize="17" 
                               FontWeight="SemiBold"
                               Foreground="#1A237E"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,12"/>

                    <!-- Роль -->
                    <Border Background="#E3F2FD" 
                            CornerRadius="12"
                            Padding="10,5">
                        <TextBlock Text="Разработка логики и бэкенда" 
                                   FontSize="13"
                                   Foreground="#1565C0"
                                   HorizontalAlignment="Center"
                                   TextWrapping="Wrap"
                                   TextAlignment="Center"/>
                    </Border>
                </StackPanel>
            </Border>

            <!-- ПРАВАЯ КАРТОЧКА: Дмитрий -->
            <Border Grid.Column="1" 
                    Background="White"
                    CornerRadius="20"
                    Margin="8"
                    Padding="20">
                <Border.Effect>
                    <DropShadowEffect ShadowDepth="1" BlurRadius="15" Opacity="0.15" Color="#000000"/>
                </Border.Effect>

                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">

                    <!-- Фото -->
                    <Border Width="130" Height="130" 
                            CornerRadius="65"
                            BorderBrush="#4CAF50"
                            BorderThickness="3">
                        <Border.Background>
                            <ImageBrush ImageSource="/Library;component/images/{EA06704D-0329-4CBC-AAE6-D89A0C0B4851}.png"
                                        Stretch="UniformToFill"/>
                        </Border.Background>
                    </Border>

                    <!-- Имя -->
                    <TextBlock Text="Ленкевич Дмитрий" 
                               FontSize="17" 
                               FontWeight="SemiBold"
                               Foreground="#1B5E20"
                               HorizontalAlignment="Center"
                               Margin="0,18,0,12"/>

                    <!-- Роль -->
                    <Border Background="#E8F5E9" 
                            CornerRadius="12"
                            Padding="10,5">
                        <TextBlock Text="Разработка дизайна и интерфейса" 
                                   FontSize="13"
                                   Foreground="#2E7D32"
                                   HorizontalAlignment="Center"
                                   TextWrapping="Wrap"
                                   TextAlignment="Center"/>
                    </Border>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Кнопка ОК -->
        <Button Grid.Row="2"
                Content="ОК" 
                Width="110" 
                Height="36"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="#2196F3"
                Foreground="White"
                FontSize="14"
                FontWeight="Bold"
                BorderThickness="0"
                Click="OkButton_Click">
            <Button.Style>
                <Style TargetType="Button">
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}"
                                        CornerRadius="10"
                                        BorderThickness="0">
                                    <ContentPresenter HorizontalAlignment="Center" 
                                                      VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                    <Style.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="#1976D2"/>
                            <Setter Property="Cursor" Value="Hand"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </Button.Style>
        </Button>
    </Grid>
    </Window>