<Window x:Class="FactoryCalculator.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:FactoryCalculator"
        mc:Ignorable="d"
        Title="Научный калькулятор" Height="550" Width="500"
        WindowStartupLocation="CenterScreen"
        Background="#1A1A1A">

    <Window.Resources>
        <Style x:Key="NumberButtonStyle" TargetType="Button">
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="FontWeight" Value="DemiBold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#2D2D2D"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Margin="3">
                            <ContentPresenter HorizontalAlignment="Center"
                                            VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#3D3D3D"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#1F1F1F"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="OperatorButtonStyle" TargetType="Button" BasedOn="{StaticResource NumberButtonStyle}">
            <Setter Property="Background" Value="#FF9F0A"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="22"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FFB83B"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#E08900"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="FunctionButtonStyle" TargetType="Button" BasedOn="{StaticResource NumberButtonStyle}">
            <Setter Property="Background" Value="#3D3D3D"/>
            <Setter Property="Foreground" Value="#FF9F0A"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#4D4D4D"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#2D2D2D"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="EqualsButtonStyle" TargetType="Button" BasedOn="{StaticResource OperatorButtonStyle}">
            <Setter Property="Background" Value="#FF9F0A"/>
            <Setter Property="FontSize" Value="24"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>

        <Style x:Key="ExpandButtonStyle" TargetType="Button" BasedOn="{StaticResource FunctionButtonStyle}">
            <Setter Property="Background" Value="#FF9F0A"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="18"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Дисплей -->
        <Border Grid.Row="0" 
                Margin="15,15,15,0" 
                Background="#1F1F1F" 
                CornerRadius="12"
                BorderBrush="#3D3D3D"
                BorderThickness="1">
            <TextBox x:Name="DisplayTextBox"
                     Text="0"
                     IsReadOnly="True"
                     HorizontalAlignment="Stretch" 
                     VerticalAlignment="Center" 
                     Background="Transparent"
                     Foreground="White"
                     Height="70"
                     TextAlignment="Right"
                     FontSize="36"
                     FontWeight="Light"
                     Padding="15,0"
                     BorderThickness="0"/>
        </Border>

        <!-- Кнопка расширения -->
        <Button Grid.Row="1" 
                Content=" Научные функции" 
                Click="ToggleScientificPanel_Click"
                Style="{StaticResource ExpandButtonStyle}"
                Margin="15,10,15,10"
                Height="40"/>

        <!-- Основные кнопки -->
        <Grid Grid.Row="2" Margin="15,0,15,15">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Строка 1 -->
            <Button Grid.Row="0" Grid.Column="0" 
                    Content="C" 
                    Click="FunctionButton_Click" 
                    Style="{StaticResource FunctionButtonStyle}"/>

            <Button Grid.Row="0" Grid.Column="1" 
                    Content="⌫" 
                    Click="FunctionButton_Click" 
                    Style="{StaticResource FunctionButtonStyle}"/>

            <Button Grid.Row="0" Grid.Column="2" 
                    Content="±" 
                    Click="FunctionButton_Click" 
                    Style="{StaticResource FunctionButtonStyle}"/>

            <Button Grid.Row="0" Grid.Column="3" 
                    Content="÷" 
                    Click="OperatorButton_Click" 
                    Style="{StaticResource OperatorButtonStyle}"/>

            <!-- Строка 2 -->
            <Button Grid.Row="1" Grid.Column="0" 
                    Content="7" 
                    Click="DigitButton_Click" 
                    Style="{StaticResource NumberButtonStyle}"/>

            <Button Grid.Row="1" Grid.Column="1" 
                    Content="8" 
                    Click="DigitButton_Click" 
                    Style="{StaticResource NumberButtonStyle}"/>

            <Button Grid.Row="1" Grid.Column="2" 
                    Content="9" 
                    Click="DigitButton_Click" 
                    Style="{StaticResource NumberButtonStyle}"/>

            <Button Grid.Row="1" Grid.Column="3" 
                    Content="x" 
                    Click="OperatorButton_Click" 
                    Style="{StaticResource OperatorButtonStyle}"/>

            <!-- Строка 3 -->
            <Button Grid.Row="2" Grid.Column="0" 
                    Content="4" 
                    Click="DigitButton_Click" 
                    Style="{StaticResource NumberButtonStyle}"/>

            <Button Grid.Row="2" Grid.Column="1" 
                    Content="5" 
                    Click="DigitButton_Click" 
                    Style="{StaticResource NumberButtonStyle}"/>

            <Button Grid.Row="2" Grid.Column="2" 
                    Content="6" 
                    Click="DigitButton_Click" 
                    Style="{StaticResource NumberButtonStyle}"/>

            <Button Grid.Row="2" Grid.Column="3" 
                    Content="-" 
                    Click="OperatorButton_Click" 
                    Style="{StaticResource OperatorButtonStyle}"/>

            <!-- Строка 4 -->
            <Button Grid.Row="3" Grid.Column="0" 
                    Content="1" 
                    Click="DigitButton_Click" 
                    Style="{StaticResource NumberButtonStyle}"/>

            <Button Grid.Row="3" Grid.Column="1" 
                    Content="2" 
                    Click="DigitButton_Click" 
                    Style="{StaticResource NumberButtonStyle}"/>

            <Button Grid.Row="3" Grid.Column="2" 
                    Content="3" 
                    Click="DigitButton_Click" 
                    Style="{StaticResource NumberButtonStyle}"/>

            <Button Grid.Row="3" Grid.Column="3" 
                    Content="+" 
                    Click="OperatorButton_Click" 
                    Style="{StaticResource OperatorButtonStyle}"/>

            <!-- Строка 5 -->
            <Button Grid.Row="4" Grid.Column="0" 
                    Content="0" 
                    Click="DigitButton_Click" 
                    Style="{StaticResource NumberButtonStyle}"
                    Grid.ColumnSpan="2"/>

            <Button Grid.Row="4" Grid.Column="2" 
                    Content="." 
                    Click="FunctionButton_Click" 
                    Style="{StaticResource NumberButtonStyle}"/>

            <Button Grid.Row="4" Grid.Column="3" 
                    Content="=" 
                    Click="FunctionButton_Click" 
                    Style="{StaticResource EqualsButtonStyle}"/>
        </Grid>

        <!-- Всплывающее окно с научными функциями -->
        <Popup x:Name="ScientificPopup" 
               PlacementTarget="{Binding ElementName=DisplayTextBox}"
               Placement="Bottom"
               StaysOpen="False"
               Width="460"
               Height="380">
            <Border Background="#2D2D2D" 
                    CornerRadius="12" 
                    BorderBrush="#FF9F0A" 
                    BorderThickness="2"
                    Padding="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Заголовок -->
                    <Label Grid.Row="0" Grid.ColumnSpan="4" 
                           Content="Научные функции" 
                           Foreground="#FF9F0A" 
                           HorizontalAlignment="Center"
                           FontSize="16"
                           FontWeight="Bold"
                           Margin="0,5"/>

                    <!-- Тригонометрические функции -->
                    <Label Grid.Row="1" Grid.ColumnSpan="4" 
                           Content="Тригонометрические" 
                           Foreground="#FF9F0A" 
                           HorizontalAlignment="Center"
                           FontSize="12"
                           Margin="0,5"/>

                    <Button Grid.Row="2" Grid.Column="0" 
                            Content="sin" 
                            Click="ScientificButton_Click" 
                            Style="{StaticResource FunctionButtonStyle}"/>

                    <Button Grid.Row="2" Grid.Column="1" 
                            Content="cos" 
                            Click="ScientificButton_Click" 
                            Style="{StaticResource FunctionButtonStyle}"/>

                    <Button Grid.Row="2" Grid.Column="2" 
                            Content="tan" 
                            Click="ScientificButton_Click" 
                            Style="{StaticResource FunctionButtonStyle}"/>

                    <Button Grid.Row="2" Grid.Column="3" 
                            Content="√" 
                            Click="ScientificButton_Click" 
                            Style="{StaticResource FunctionButtonStyle}"/>

                    <!-- Степени и корни -->
                    <Label Grid.Row="3" Grid.ColumnSpan="4" 
                           Content="Степени и корни" 
                           Foreground="#FF9F0A" 
                           HorizontalAlignment="Center"
                           FontSize="12"
                           Margin="0,5"/>

                    <Button Grid.Row="4" Grid.Column="0" 
                            Content="x²" 
                            Click="ScientificButton_Click" 
                            Style="{StaticResource FunctionButtonStyle}"/>

                    <Button Grid.Row="4" Grid.Column="1" 
                            Content="xʸ" 
                            Click="ScientificButton_Click" 
                            Style="{StaticResource FunctionButtonStyle}"/>

                    <Button Grid.Row="4" Grid.Column="2" 
                            Content="%" 
                            Click="ScientificButton_Click" 
                            Style="{StaticResource FunctionButtonStyle}"/>

                    <!-- Логарифмы -->
                    <Label Grid.Row="5" Grid.ColumnSpan="4" 
                           Content="Логарифмы" 
                           Foreground="#FF9F0A" 
                           HorizontalAlignment="Center"
                           FontSize="12"
                           Margin="0,5"/>

                    <Button Grid.Row="6" Grid.Column="0" 
                            Content="log" 
                            Click="ScientificButton_Click" 
                            Style="{StaticResource FunctionButtonStyle}"/>

                    <Button Grid.Row="6" Grid.Column="1" 
                            Content="ln" 
                            Click="ScientificButton_Click" 
                            Style="{StaticResource FunctionButtonStyle}"/>

                    <!-- Память -->
                    <Label Grid.Row="7" Grid.ColumnSpan="4" 
                           Content="Память" 
                           Foreground="#FF9F0A" 
                           HorizontalAlignment="Center"
                           FontSize="12"
                           Margin="0,5"/>

                    <Button Grid.Row="8" Grid.Column="0" 
                            Content="MS" 
                            Click="ScientificButton_Click" 
                            Style="{StaticResource FunctionButtonStyle}"/>

                    <Button Grid.Row="8" Grid.Column="1" 
                            Content="MR" 
                            Click="ScientificButton_Click" 
                            Style="{StaticResource FunctionButtonStyle}"/>

                    <Button Grid.Row="8" Grid.Column="2" 
                            Content="MC" 
                            Click="ScientificButton_Click" 
                            Style="{StaticResource FunctionButtonStyle}"/>

                    <Button Grid.Row="8" Grid.Column="3" 
                            Content="M+" 
                            Click="ScientificButton_Click" 
                            Style="{StaticResource FunctionButtonStyle}"/>
                </Grid>
            </Border>
        </Popup>
    </Grid>
</Window>