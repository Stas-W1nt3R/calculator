<Window x:Class="SimpleCalculatorMVVM.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SimpleCalculatorMVVM"
        mc:Ignorable="d"
        Title="Научный калькулятор" 
        Height="600" 
        Width="500"
        WindowStartupLocation="CenterScreen"
        Background="#1A1A1A"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Window.Resources>
        <Style x:Key="NumberButtonStyle" TargetType="Button">
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="FontWeight" Value="DemiBold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#2D2D2D"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Margin="3">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#3D3D3D"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#1F1F1F"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="OperatorButtonStyle" TargetType="Button" BasedOn="{StaticResource NumberButtonStyle}">
            <Setter Property="Background" Value="#FF9F0A"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="22"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FFB83B"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#E08900"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="FunctionButtonStyle" TargetType="Button" BasedOn="{StaticResource NumberButtonStyle}">
            <Setter Property="Background" Value="#3D3D3D"/>
            <Setter Property="Foreground" Value="#FF9F0A"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#4D4D4D"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#2D2D2D"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="EqualsButtonStyle" TargetType="Button" BasedOn="{StaticResource OperatorButtonStyle}">
            <Setter Property="Background" Value="#FF9F0A"/>
            <Setter Property="FontSize" Value="24"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>

        <Style x:Key="ExpandButtonStyle" TargetType="Button" BasedOn="{StaticResource FunctionButtonStyle}">
            <Setter Property="Background" Value="#FF9F0A"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="18"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- МЕНЮ -->
        <Menu Grid.Row="0" Background="#2D2D2D" Foreground="White">
            <MenuItem Header="Справка" Foreground="White">
                <MenuItem Header="О программе" 
                          Command="{Binding ShowAboutCommand}"
                          Foreground="Black"/>
                <MenuItem Header="Об авторах" 
                          Command="{Binding ShowHelpCommand}"
                          Foreground="Black"/>
            </MenuItem>
        </Menu>

        <!-- ДИСПЛЕЙ -->
        <Border Grid.Row="1" 
                Margin="15,10,15,0" 
                Background="#1F1F1F" 
                CornerRadius="12"
                BorderBrush="#3D3D3D"
                BorderThickness="1">
            <TextBox Text="{Binding DisplayText, UpdateSourceTrigger=PropertyChanged}"
                     IsReadOnly="True"
                     HorizontalAlignment="Stretch" 
                     VerticalAlignment="Center" 
                     Background="Transparent"
                     Foreground="White"
                     Height="70"
                     TextAlignment="Right"
                     FontSize="36"
                     FontWeight="Light"
                     Padding="15,0"
                     BorderThickness="0"/>
        </Border>

        <!-- КНОПКА РАСШИРЕНИЯ -->
        <Button Grid.Row="2" 
                Content="Научные функции" 
                Command="{Binding ToggleScientificCommand}"
                Style="{StaticResource ExpandButtonStyle}"
                Margin="15,10,15,10"
                Height="40"/>

        <!-- ОСНОВНЫЕ КНОПКИ -->
        <Grid Grid.Row="3" Margin="15,0,15,15">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Строка 1 -->
            <Button Grid.Row="0" Grid.Column="0" 
                    Content="C" 
                    Command="{Binding FunctionCommand}"
                    CommandParameter="Clear"
                    Style="{StaticResource FunctionButtonStyle}"/>

            <Button Grid.Row="0" Grid.Column="1" 
                    Content="⌫" 
                    Command="{Binding FunctionCommand}"
                    CommandParameter="Delete"
                    Style="{StaticResource FunctionButtonStyle}"/>

            <Button Grid.Row="0" Grid.Column="2" 
                    Content="±" 
                    Command="{Binding FunctionCommand}"
                    CommandParameter="PlusMinus"
                    Style="{StaticResource FunctionButtonStyle}"/>

            <Button Grid.Row="0" Grid.Column="3" 
                    Content="÷" 
                    Command="{Binding OperatorCommand}"
                    CommandParameter="÷"
                    Style="{StaticResource OperatorButtonStyle}"/>

            <!-- Строка 2 -->
            <Button Grid.Row="1" Grid.Column="0" 
                    Content="7" 
                    Command="{Binding DigitCommand}"
                    CommandParameter="7"
                    Style="{StaticResource NumberButtonStyle}"/>

            <Button Grid.Row="1" Grid.Column="1" 
                    Content="8" 
                    Command="{Binding DigitCommand}"
                    CommandParameter="8"
                    Style="{StaticResource NumberButtonStyle}"/>

            <Button Grid.Row="1" Grid.Column="2" 
                    Content="9" 
                    Command="{Binding DigitCommand}"
                    CommandParameter="9"
                    Style="{StaticResource NumberButtonStyle}"/>

            <Button Grid.Row="1" Grid.Column="3" 
                    Content="x" 
                    Command="{Binding OperatorCommand}"
                    CommandParameter="x"
                    Style="{StaticResource OperatorButtonStyle}"/>

            <!-- Строка 3 -->
            <Button Grid.Row="2" Grid.Column="0" 
                    Content="4" 
                    Command="{Binding DigitCommand}"
                    CommandParameter="4"
                    Style="{StaticResource NumberButtonStyle}"/>

            <Button Grid.Row="2" Grid.Column="1" 
                    Content="5" 
                    Command="{Binding DigitCommand}"
                    CommandParameter="5"
                    Style="{StaticResource NumberButtonStyle}"/>

            <Button Grid.Row="2" Grid.Column="2" 
                    Content="6" 
                    Command="{Binding DigitCommand}"
                    CommandParameter="6"
                    Style="{StaticResource NumberButtonStyle}"/>

            <Button Grid.Row="2" Grid.Column="3" 
                    Content="-" 
                    Command="{Binding OperatorCommand}"
                    CommandParameter="-"
                    Style="{StaticResource OperatorButtonStyle}"/>

            <!-- Строка 4 -->
            <Button Grid.Row="3" Grid.Column="0" 
                    Content="1" 
                    Command="{Binding DigitCommand}"
                    CommandParameter="1"
                    Style="{StaticResource NumberButtonStyle}"/>

            <Button Grid.Row="3" Grid.Column="1" 
                    Content="2" 
                    Command="{Binding DigitCommand}"
                    CommandParameter="2"
                    Style="{StaticResource NumberButtonStyle}"/>

            <Button Grid.Row="3" Grid.Column="2" 
                    Content="3" 
                    Command="{Binding DigitCommand}"
                    CommandParameter="3"
                    Style="{StaticResource NumberButtonStyle}"/>

            <Button Grid.Row="3" Grid.Column="3" 
                    Content="+" 
                    Command="{Binding OperatorCommand}"
                    CommandParameter="+"
                    Style="{StaticResource OperatorButtonStyle}"/>

            <!-- Строка 5 -->
            <Button Grid.Row="4" Grid.Column="0" 
                    Content="0" 
                    Command="{Binding DigitCommand}"
                    CommandParameter="0"
                    Style="{StaticResource NumberButtonStyle}"
                    Grid.ColumnSpan="2"/>

            <Button Grid.Row="4" Grid.Column="2" 
                    Content="." 
                    Command="{Binding FunctionCommand}"
                    CommandParameter="Decimal"
                    Style="{StaticResource NumberButtonStyle}"/>

            <Button Grid.Row="4" Grid.Column="3" 
                    Content="=" 
                    Command="{Binding FunctionCommand}"
                    CommandParameter="Equals"
                    Style="{StaticResource EqualsButtonStyle}"/>
        </Grid>

        <!-- POPUP -->
        <Popup IsOpen="{Binding IsScientificPopupOpen}"
               Placement="Center"
               StaysOpen="False"
               Width="460"
               Height="380"
               Grid.RowSpan="4">
            <Border Background="#2D2D2D" 
                    CornerRadius="12" 
                    BorderBrush="#FF9F0A" 
                    BorderThickness="2"
                    Padding="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Label Grid.Row="0" Grid.ColumnSpan="4" 
                           Content="Научные функции" 
                           Foreground="#FF9F0A" 
                           HorizontalAlignment="Center"
                           FontSize="16"
                           FontWeight="Bold"
                           Margin="0,5"/>

                    <Label Grid.Row="1" Grid.ColumnSpan="4" 
                           Content="Тригонометрические" 
                           Foreground="#FF9F0A" 
                           HorizontalAlignment="Center"
                           FontSize="12"
                           Margin="0,5"/>

                    <Button Grid.Row="2" Grid.Column="0" 
                            Content="sin" 
                            Command="{Binding ScientificCommand}"
                            CommandParameter="Sin"
                            Style="{StaticResource FunctionButtonStyle}"/>

                    <Button Grid.Row="2" Grid.Column="1" 
                            Content="cos" 
                            Command="{Binding ScientificCommand}"
                            CommandParameter="Cos"
                            Style="{StaticResource FunctionButtonStyle}"/>

                    <Button Grid.Row="2" Grid.Column="2" 
                            Content="tan" 
                            Command="{Binding ScientificCommand}"
                            CommandParameter="Tan"
                            Style="{StaticResource FunctionButtonStyle}"/>

                    <Button Grid.Row="2" Grid.Column="3" 
                            Content="√" 
                            Command="{Binding ScientificCommand}"
                            CommandParameter="Sqrt"
                            Style="{StaticResource FunctionButtonStyle}"/>

                    <Label Grid.Row="3" Grid.ColumnSpan="4" 
                           Content="Степени и корни" 
                           Foreground="#FF9F0A" 
                           HorizontalAlignment="Center"
                           FontSize="12"
                           Margin="0,5"/>

                    <Button Grid.Row="4" Grid.Column="0" 
                            Content="x²" 
                            Command="{Binding ScientificCommand}"
                            CommandParameter="Power"
                            Style="{StaticResource FunctionButtonStyle}"/>

                    <Button Grid.Row="4" Grid.Column="1" 
                            Content="xʸ" 
                            Command="{Binding ScientificCommand}"
                            CommandParameter="PowerY"
                            Style="{StaticResource FunctionButtonStyle}"/>

                    <Button Grid.Row="4" Grid.Column="2" 
                            Content="%" 
                            Command="{Binding ScientificCommand}"
                            CommandParameter="Percent"
                            Style="{StaticResource FunctionButtonStyle}"/>

                    <Label Grid.Row="5" Grid.ColumnSpan="4" 
                           Content="Логарифмы" 
                           Foreground="#FF9F0A" 
                           HorizontalAlignment="Center"
                           FontSize="12"
                           Margin="0,5"/>

                    <Button Grid.Row="6" Grid.Column="0" 
                            Content="log" 
                            Command="{Binding ScientificCommand}"
                            CommandParameter="Log"
                            Style="{StaticResource FunctionButtonStyle}"/>

                    <Button Grid.Row="6" Grid.Column="1" 
                            Content="ln" 
                            Command="{Binding ScientificCommand}"
                            CommandParameter="Ln"
                            Style="{StaticResource FunctionButtonStyle}"/>

                    <Label Grid.Row="7" Grid.ColumnSpan="4" 
                           Content="Память" 
                           Foreground="#FF9F0A" 
                           HorizontalAlignment="Center"
                           FontSize="12"
                           Margin="0,5"/>

                    <Button Grid.Row="8" Grid.Column="0" 
                            Content="MS" 
                            Command="{Binding ScientificCommand}"
                            CommandParameter="MemorySave"
                            Style="{StaticResource FunctionButtonStyle}"/>

                    <Button Grid.Row="8" Grid.Column="1" 
                            Content="MR" 
                            Command="{Binding ScientificCommand}"
                            CommandParameter="MemoryRecall"
                            Style="{StaticResource FunctionButtonStyle}"/>

                    <Button Grid.Row="8" Grid.Column="2" 
                            Content="MC" 
                            Command="{Binding ScientificCommand}"
                            CommandParameter="MemoryClear"
                            Style="{StaticResource FunctionButtonStyle}"/>

                    <Button Grid.Row="8" Grid.Column="3" 
                            Content="M+" 
                            Command="{Binding ScientificCommand}"
                            CommandParameter="MemoryAdd"
                            Style="{StaticResource FunctionButtonStyle}"/>
                </Grid>
            </Border>
        </Popup>
    </Grid>
</Window>